<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoLog.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PhotoLog.Avalonia.MainWindow"
        Width="1200" Height="860"
        MinWidth="960" MinHeight="640"
        Title="PhotoLog"
        Icon="/Assets/icon.png"
        Background="{DynamicResource BrushWindow}">

  <DockPanel Margin="22">

    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="12" ClipToBounds="True"
                Background="#0A0A0A" VerticalAlignment="Center">
          <Image Source="/Assets/icon.png" Stretch="UniformToFill"
                 Width="40" Height="40"/>
        </Border>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="PhotoLog" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Classes="subtitle" TextWrapping="Wrap" MaxWidth="560"
                     Text="Stamp date, time, and optional address. Captions rename exports (not drawn on the image)."/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="ThemeBtn" Classes="quiet" Content="Light mode" Click="Theme_Click"
                ToolTip.Tip="Switch between dark and light theme"/>
        <Button Classes="quiet" Content="Browse…" Click="Browse_Click"
                ToolTip.Tip="Pick a folder"/>
        <Button Classes="accent" Content="Load folder" Click="Browse_Click"
                ToolTip.Tip="Pick a folder and load its photos"/>
      </StackPanel>
    </Grid>

    <!-- Folder path -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12" Padding="12,10">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" Margin="2,0,10,0" Opacity="0.9"
                     Foreground="{DynamicResource BrushAccent}"/>
          <TextBox Grid.Column="1" x:Name="FolderBox"
                   BorderThickness="0" Background="Transparent" Padding="0,6"
                   PlaceholderText="/path/to/photos — or type a path and press Enter"
                   ToolTip.Tip="Path to a folder of photos. Press Enter to load."
                   KeyDown="Folder_KeyDown"/>
        </Grid>
        <TextBlock x:Name="Status" Classes="hint" TextWrapping="Wrap" Margin="28,0,0,0"
                   Text="Choose a folder to get started."/>
      </StackPanel>
    </Border>

    <!-- Options: Date|Time row, then full-width Drop shadow (X/Y must never clip), then Address -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="12">
        <!-- Line 1: Date | Time only -->
        <Grid ColumnDefinitions="Auto,Auto,*">
          <StackPanel Margin="0,0,10,0">
            <TextBlock Classes="label" Text="Date"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CalendarDatePicker x:Name="DatePart" Width="148"
                                  ToolTip.Tip="Leave empty to keep each photo’s day."
                                  SelectedDateChanged="DateChanged"/>
              <Button Classes="quiet" Content="Clear" Padding="12,6" Click="ClearDate_Click"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Background="{DynamicResource BrushBorder}" Margin="2,0"/>

          <StackPanel Grid.Column="2" Margin="10,0,0,0">
            <TextBlock Classes="label" Text="Time"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TimePicker x:Name="TimePart" Width="168" ClockIdentifier="12HourClock" UseSeconds="True"
                          ToolTip.Tip="Leave empty to keep each photo’s clock."
                          SelectedTimeChanged="TimeChanged"/>
              <Button Classes="quiet" Content="Clear" Padding="12,6" Click="ClearTime_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Line 2: Drop shadow alone — full width so X/Y digits + spinners never squeeze -->
        <StackPanel ToolTip.Tip="Weight + freeform offset (+X right, −Y up). Saved between sessions.">
          <TextBlock Classes="label" Text="Drop shadow"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="DropBox" Width="100" MinHeight="40" VerticalAlignment="Center"
                      SelectedIndex="1" SelectionChanged="DropChanged">
              <ComboBoxItem Content="Off" Tag="Off"/>
              <ComboBoxItem Content="Light" Tag="Light"/>
              <ComboBoxItem Content="Heavy" Tag="Heavy"/>
            </ComboBox>
            <TextBlock Text="X" Classes="hint" VerticalAlignment="Center"/>
            <!-- Room for “-20” + button spinner; no fixed Height (that was clipping the digits). -->
            <NumericUpDown x:Name="ShadowXBox" Value="1" Minimum="-20" Maximum="20"
                           Increment="1" FormatString="0"
                           Width="128" MinWidth="128" MinHeight="40"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Padding="10,6"
                           ShowButtonSpinner="True" AllowSpin="True"
                           ButtonSpinnerLocation="Right"
                           ValueChanged="OffsetChanged"/>
            <TextBlock Text="Y" Classes="hint" VerticalAlignment="Center"/>
            <NumericUpDown x:Name="ShadowYBox" Value="-1" Minimum="-20" Maximum="20"
                           Increment="1" FormatString="0"
                           Width="128" MinWidth="128" MinHeight="40"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Padding="10,6"
                           ShowButtonSpinner="True" AllowSpin="True"
                           ButtonSpinnerLocation="Right"
                           ValueChanged="OffsetChanged"/>
            <Button Classes="quiet" Content="Refresh" Padding="14,8" MinHeight="40"
                    VerticalAlignment="Center" Click="Refresh_Click"/>
          </StackPanel>
        </StackPanel>

        <!-- Line 3: multi-line address -->
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Address (optional)"/>
          <TextBox x:Name="AddrBox" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="64" MaxHeight="120"
                   LostFocus="Addr_LostFocus"
                   PlaceholderText="Optional address lines (applied to selected photos only)"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Footer: ONE line — output + browse + apply -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" Padding="14,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Classes="label" Text="Output folder" Margin="0,0,10,0"
                   VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" x:Name="OutBox" VerticalAlignment="Center"
                 PlaceholderText="Where stamped copies are written"
                 LostFocus="OutBox_LostFocus"/>
        <Button Grid.Column="2" Classes="quiet" Content="Browse…" Margin="8,0,0,0"
                VerticalAlignment="Center" Click="OutBrowse_Click"/>
        <Button Grid.Column="3" x:Name="ApplyBtn" Classes="accent" Margin="10,0,0,0"
                VerticalAlignment="Center"
                Content="✓  Apply to selected" Click="Apply_Click"
                ToolTip.Tip="Write stamped copies. Captioned photos are renamed."/>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" x:Name="Result" Classes="hint"
                   Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Select photos, then apply. Originals stay untouched."/>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid ColumnDefinitions="3*,2*">

      <Border Classes="card" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel x:Name="LibToolbar" DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="CountText" Classes="section" Text="0 of 0 selected"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="PrevSelBtn" Classes="quiet" Content="↑ sel" Padding="10,6"
                        IsEnabled="False" Click="PrevSelected_Click"
                        ToolTip.Tip="Jump to previous selected photo (like editor find prev)"/>
                <Button x:Name="NextSelBtn" Classes="quiet" Content="↓ sel" Padding="10,6"
                        IsEnabled="False" Click="NextSelected_Click"
                        ToolTip.Tip="Jump to next selected photo (like editor find next)"/>
                <Button Classes="quiet" Content="Select all" Padding="12,6" Click="SelectAll_Click"/>
                <Button Classes="quiet" Content="Select none" Padding="12,6" Click="SelectNone_Click"/>
              </StackPanel>
            </Grid>
            <!-- AI select: YOLO COCO-80 only (not free-form). Detect once, cache labels, re-filter free. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="hint" Text="AI select" VerticalAlignment="Center"
                         ToolTip.Tip="YOLO26n: fixed 80 COCO object classes (not free-form captions). First pass detects; later category picks re-use the cache — near instant."/>
              <ComboBox x:Name="AiCategoryBox" Width="150" SelectedIndex="0"
                        ToolTip.Tip="COCO object groups covering all 80 classes YOLO knows.">
                <!-- filled in code from YoloPick.Groups so list stays in sync -->
              </ComboBox>
              <TextBox x:Name="AiCustomBox" Width="140"
                       PlaceholderText="or dog / chair…"
                       ToolTip.Tip="Overrides dropdown. Any COCO class name (dog, chair, laptop, pizza, …). Not free-form scenes."/>
              <Button x:Name="AiSelectBtn" Classes="quiet" Content="AI select"
                      Padding="12,6" Click="AiSelect_Click"
                      ToolTip.Tip="First scan runs YOLO and caches labels. Next AI select on the same folder only filters the cache."/>
            </StackPanel>
          </StackPanel>

          <Grid>
            <Border x:Name="EmptyGrid" Classes="dashEmpty" IsVisible="True" Margin="2">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="12"
                            HorizontalAlignment="Center" MaxWidth="300">
                  <Border Width="72" Height="72" CornerRadius="36"
                          Background="{DynamicResource BrushAccentSoft}"
                          HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="No photos loaded" FontSize="16" FontWeight="SemiBold"
                             HorizontalAlignment="Center" TextAlignment="Center"/>
                  <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                             HorizontalAlignment="Center"
                             Text="Load a folder of photos to stamp dates and captions."/>
                  <Button Classes="accent" Content="Browse for folder…"
                          HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                          MinWidth="180" Padding="22,10" Click="Browse_Click"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Library + VS Code-style overview ruler (ticks = selected photos). -->
            <Grid x:Name="LibScrollHost" IsVisible="False" ColumnDefinitions="*,Auto">
              <ScrollViewer x:Name="PhotoScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            ScrollChanged="PhotoScroll_ScrollChanged">
                <ItemsControl x:Name="PhotoGrid">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DayGroup">
                      <StackPanel Margin="0,0,0,10">
                        <Border Cursor="Hand" Background="Transparent"
                                ToolTip.Tip="Select or deselect every photo from this day"
                                PointerPressed="DayHeader_Click">
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,10,2,8">
                            <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushBorderMuted}" Background="{DynamicResource BrushCard}"
                                    IsVisible="{Binding ShowEmptyDayCheck}"/>
                            <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushSelect}" Background="{DynamicResource BrushSelect}"
                                    IsVisible="{Binding ShowPartialDayCheck}">
                              <Path Width="10" Height="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stretch="Fill" Stroke="White" StrokeThickness="2"
                                    StrokeLineCap="Round" Data="M 0,1 L 10,1"/>
                            </Border>
                            <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushSelect}" Background="{DynamicResource BrushSelect}"
                                    IsVisible="{Binding ShowAllDayCheck}">
                              <Path Width="12" Height="12"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                    StrokeLineCap="Round" StrokeJoin="Round"
                                    Data="M 1,6 L 4.5,9.5 L 11,2"/>
                            </Border>
                            <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Photos}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PhotoItem">
                              <!-- Cell size = full image aspect scaled into max box (never crop). -->
                              <Border Height="{Binding CellH}" Width="{Binding CellW}" Margin="3"
                                      Background="Transparent" Cursor="Hand"
                                      ToolTip.Tip="{Binding Tip}"
                                      PointerPressed="Cell_Click">
                                <Panel>
                                  <Border CornerRadius="10" Margin="2"
                                          Background="{DynamicResource BrushSelectPlate}"
                                          BoxShadow="0 2 12 0 #20000000"
                                          IsVisible="{Binding Selected}"/>
                                  <Border Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                          Margin="0,4" CornerRadius="2"
                                          Background="{DynamicResource BrushSelect}"
                                          IsVisible="{Binding Selected}" ZIndex="5"/>
                                  <Border Margin="{Binding ThumbMargin}" CornerRadius="8"
                                          ClipToBounds="True" Background="{DynamicResource BrushThumbBg}">
                                    <Panel>
                                      <Image Source="{Binding Thumb}" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      <Border Width="24" Height="24" Margin="6" ZIndex="4"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              CornerRadius="12" BorderThickness="2"
                                              BorderBrush="#FFFFFF" Background="#99000000"
                                              IsVisible="{Binding ShowEmptyCheck}"/>
                                      <Border Width="24" Height="24" Margin="6" ZIndex="4"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              CornerRadius="12" BorderThickness="2"
                                              BorderBrush="{DynamicResource BrushSelect}"
                                              Background="{DynamicResource BrushSelect}"
                                              IsVisible="{Binding Selected}">
                                        <Path Width="11" Height="11"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform" Stroke="White" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              Data="M 1,6 L 4.5,9.5 L 11,2"/>
                                      </Border>
                                    </Panel>
                                  </Border>
                                </Panel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Overview ruler: purple ticks = selected photos (editor-style scroll map). -->
              <Border Grid.Column="1" x:Name="SelectOverview" Width="18" Margin="6,0,0,0"
                      IsVisible="False" Cursor="Hand" ClipToBounds="True"
                      CornerRadius="6" BorderThickness="1"
                      BorderBrush="{DynamicResource BrushBorder}"
                      Background="{DynamicResource BrushField}"
                      ToolTip.Tip="Selection map (like editor scrollbar marks). Click a tick to jump there."
                      PointerPressed="SelectOverview_Pressed"
                      SizeChanged="SelectOverview_SizeChanged">
                <Panel>
                  <!-- faint track -->
                  <Border Margin="4,2" CornerRadius="3"
                          Background="{DynamicResource BrushBorder}" Opacity="0.35"/>
                  <!-- current viewport (semi-transparent band) -->
                  <Border x:Name="SelectViewport" Margin="3,0" HorizontalAlignment="Stretch"
                          Height="24" VerticalAlignment="Top" CornerRadius="3"
                          Background="{DynamicResource BrushText}" Opacity="0.12"
                          IsHitTestVisible="False"/>
                  <Canvas x:Name="SelectMarks" Margin="2,2"/>
                </Panel>
              </Border>
            </Grid>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Preview -->
      <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="section" Text="Preview" Margin="0,0,0,10"/>

          <Grid Grid.Row="1" MinHeight="180">
            <Border x:Name="PreviewEmpty" Classes="dashEmpty" IsVisible="True">
              <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                          MaxWidth="260">
                <Border Width="72" Height="72" CornerRadius="16"
                        Background="{DynamicResource BrushAccentSoft}"
                        HorizontalAlignment="Center">
                  <TextBlock Text="🖼" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Your preview will appear here" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="Select a photo from the left to preview the stamped date and time."/>
              </StackPanel>
            </Border>
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
          </Grid>

          <TextBlock Grid.Row="2" x:Name="PreviewName" Classes="hint" Margin="0,10,0,0"
                     TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                     MaxLines="2" IsVisible="False" Text=""/>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBox x:Name="CaptionBox"
                     PlaceholderText="Caption — used as export file name (not drawn on the photo)"
                     LostFocus="Caption_LostFocus" IsEnabled="False"/>
            <Button Grid.Column="1" x:Name="CaptionBtn" Classes="quiet" Content="Caption"
                    Margin="8,0,0,0" IsEnabled="False" Click="Caption_Click"/>
          </Grid>

          <Grid Grid.Row="4" ColumnDefinitions="*,*" Margin="0,12,0,0">
            <Button x:Name="SaveOneBtn" Classes="quiet" Content="Save this photo"
                    IsEnabled="False" Click="SaveOne_Click" Margin="0,0,4,0"
                    HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" x:Name="CaptionAllBtn" Classes="quiet" Content="Caption selected"
                    IsEnabled="False" Click="CaptionAll_Click" Margin="4,0,0,0"
                    HorizontalAlignment="Stretch"/>
          </Grid>

          <Button Grid.Row="5" x:Name="DownloadModelBtn" Classes="quiet" Margin="0,8,0,0"
                  Content="Download caption model" HorizontalAlignment="Stretch"
                  Click="DownloadModel_Click"
                  ToolTip.Tip="Gemma 4 E2B (~3.4 GB) for Caption only. AI select uses YOLO26n (~10 MB) and auto-downloads."/>

          <StackPanel Grid.Row="6" Margin="0,10,0,0" Spacing="6">
            <ProgressBar x:Name="AiProgress" Minimum="0" Maximum="100" IsVisible="False"/>
            <TextBlock x:Name="AiStatus" Classes="hint" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
