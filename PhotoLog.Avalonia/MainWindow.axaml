<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoLog.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PhotoLog.Avalonia.MainWindow"
        Width="1200" Height="840"
        MinWidth="900" MinHeight="600"
        Title="PhotoLog">

  <!-- hierarchy: folder → options → day-segmented grid/preview → export. -->
  <DockPanel Margin="20">

    <!-- header: title + folder load -->
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="PhotoLog" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Classes="hint" FontSize="13" TextWrapping="Wrap"
                   Text="Stamp date/time, optional address, and a caption. Captioned exports are renamed from that caption. Overrides also rewrite EXIF on the copy."/>
      </StackPanel>

      <!-- One open action: Browse picks + loads. Typed path + Enter also loads (no second button). -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="FolderBox"
                 PlaceholderText="Folder with photos — or type a path and press Enter"
                 ToolTip.Tip="Path to a folder of photos on this machine. Press Enter to load."
                 KeyDown="Folder_KeyDown"/>
        <Button Grid.Column="1" Content="Open folder…" Margin="8,0,0,0" Classes="accent"
                ToolTip.Tip="Pick a folder and load its photos"
                Click="Browse_Click"/>
      </Grid>
      <TextBlock x:Name="Status" Classes="hint" TextWrapping="Wrap"
                 Text="Open a folder of photos to get started."/>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Date" VerticalAlignment="Center"/>
              <CalendarDatePicker x:Name="DatePart" Width="150"
                                  ToolTip.Tip="Leave empty to keep each photo’s day. Picked date replaces only the day."
                                  SelectedDateChanged="DateChanged"/>
              <Button Content="Clear" VerticalAlignment="Center"
                      ToolTip.Tip="Use each photo’s own date again"
                      Click="ClearDate_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Time" VerticalAlignment="Center"/>
              <TimePicker x:Name="TimePart" Width="150" ClockIdentifier="12HourClock" UseSeconds="True"
                          ToolTip.Tip="Leave empty to keep each photo’s clock. Picked time replaces only the time."
                          SelectedTimeChanged="TimeChanged"/>
              <Button Content="Clear" VerticalAlignment="Center"
                      ToolTip.Tip="Use each photo’s own time again"
                      Click="ClearTime_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,4" VerticalAlignment="Center"
                        ToolTip.Tip="Weight: Off / Light (one twin) / Heavy (thicker multi-pass). Offset is freeform — +X right, −Y up. All saved between sessions.">
              <TextBlock Classes="label" Text="Drop shadow" VerticalAlignment="Center"/>
              <ComboBox x:Name="DropBox" Width="100" SelectedIndex="1"
                        SelectionChanged="DropChanged">
                <ComboBoxItem Content="Off" Tag="Off"/>
                <ComboBoxItem Content="Light" Tag="Light"/>
                <ComboBoxItem Content="Heavy" Tag="Heavy"/>
              </ComboBox>
              <!-- Wide enough that the value isn’t eaten by the spinner buttons (was 84 → blank). -->
              <TextBlock Classes="label" Text="X" VerticalAlignment="Center"/>
              <NumericUpDown x:Name="ShadowXBox" Value="1" Minimum="-20" Maximum="20"
                             Increment="1" FormatString="0"
                             Width="120" MinWidth="120" Height="32"
                             HorizontalContentAlignment="Center"
                             ShowButtonSpinner="True" AllowSpin="True"
                             ValueChanged="OffsetChanged"/>
              <TextBlock Classes="label" Text="Y" VerticalAlignment="Center"/>
              <NumericUpDown x:Name="ShadowYBox" Value="-1" Minimum="-20" Maximum="20"
                             Increment="1" FormatString="0"
                             Width="120" MinWidth="120" Height="32"
                             HorizontalContentAlignment="Center"
                             ShowButtonSpinner="True" AllowSpin="True"
                             ValueChanged="OffsetChanged"/>
            </StackPanel>
            <Button Content="Refresh previews" Margin="0,0,0,4" VerticalAlignment="Center"
                    Click="Refresh_Click"/>
          </WrapPanel>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="label" Text="Address" Margin="0,6,8,0" VerticalAlignment="Top"/>
            <TextBox Grid.Column="1" x:Name="AddrBox" AcceptsReturn="True" MinHeight="56" MaxHeight="96"
                     LostFocus="Addr_LostFocus"
                     PlaceholderText="Optional address lines (selected photos only)"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- footer: export path + apply -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,16,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Classes="label" Text="Output folder" Margin="0,0,8,0"/>
        <TextBox Grid.Column="1" x:Name="OutBox"
                 PlaceholderText="Where stamped copies are written"
                 LostFocus="OutBox_LostFocus"/>
        <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="OutBrowse_Click"/>
        <Button Grid.Column="3" x:Name="ApplyBtn" Content="Apply to selected" Margin="8,0,0,0"
                Classes="accent" Click="Apply_Click"
                ToolTip.Tip="Write stamped copies with EXIF matching any date/time override. Captioned photos are renamed."/>
      </Grid>
      <TextBlock x:Name="Result" Classes="hint" TextWrapping="Wrap"
                 Text="Select photos, then apply. Originals stay untouched."/>
    </StackPanel>

    <!-- body: day-segmented grid + preview -->
    <Grid ColumnDefinitions="3*,2*" Margin="0,14,0,0">

      <Border Classes="card">
        <DockPanel>
          <!-- selection toolbar only when photos are loaded -->
          <Grid x:Name="LibToolbar" DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
                Margin="0,0,0,8" IsVisible="False">
            <TextBlock x:Name="CountText" Text="0 of 0 selected" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Select all" Click="SelectAll_Click"/>
              <Button Content="Select none" Click="SelectNone_Click"/>
            </StackPanel>
          </Grid>

          <!-- fill remaining space; empty state uses * / Auto / * so it is truly centered -->
          <Grid>
            <Grid x:Name="EmptyGrid" IsVisible="True" Margin="24">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No photos loaded" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" MaxWidth="280"
                           Text="Open a folder to stamp dates and optional captions."/>
                <Button Content="Open folder…" Classes="accent"
                        HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                        MinWidth="160" Padding="24,8" Click="Browse_Click"/>
              </StackPanel>
            </Grid>

          <!-- Google Photos-style: day headers (select-all) + aspect-true wrap of thumbs -->
          <ScrollViewer x:Name="PhotoScroll" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PhotoGrid">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:DayGroup">
                  <StackPanel Margin="0,0,0,10">
                    <!-- Day header: click selects/deselects that whole day. Checks only in selection mode. -->
                    <Border Cursor="Hand" Background="Transparent"
                            ToolTip.Tip="Select or deselect every photo from this day"
                            PointerPressed="DayHeader_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,10,2,8">
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                                BorderBrush="#5F6368" Background="Transparent"
                                IsVisible="{Binding ShowEmptyDayCheck}"/>
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                                BorderBrush="#1A73E8" Background="#1A73E8"
                                IsVisible="{Binding ShowPartialDayCheck}">
                          <Path Width="10" Height="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Stretch="Fill" Stroke="White" StrokeThickness="2"
                                StrokeLineCap="Round" Data="M 0,1 L 10,1"/>
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                                BorderBrush="#1A73E8" Background="#1A73E8"
                                IsVisible="{Binding ShowAllDayCheck}">
                          <Path Width="12" Height="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                StrokeLineCap="Round" StrokeJoin="Round"
                                Data="M 1,6 L 4.5,9.5 L 11,2"/>
                        </Border>
                        <TextBlock Text="{Binding Header}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Photos}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PhotoItem">
                          <!-- Cell keeps full size. Selected: photo shrinks (margin) so a larger plate
                               sits behind it (Google Photos “huge behind”). Browse: full bleed, no chrome. -->
                          <Border Height="152" Width="{Binding CellW}" Margin="3"
                                  Background="Transparent" Cursor="Hand"
                                  ToolTip.Tip="{Binding Tip}"
                                  PointerPressed="Cell_Click">
                            <Panel>
                              <!-- plate behind (only when selected) -->
                              <Border CornerRadius="10" Margin="2"
                                      Background="#E8EAED"
                                      BoxShadow="0 2 10 0 #40000000"
                                      IsVisible="{Binding Selected}"/>
                              <!-- photo card: full cell, or inset when selected -->
                              <Border Margin="{Binding ThumbMargin}" CornerRadius="6"
                                      ClipToBounds="True" Background="#14808080">
                                <Panel>
                                  <Image Source="{Binding Thumb}" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  <!-- empty circle only in selection mode on unselected thumbs -->
                                  <Border Width="24" Height="24" Margin="6" ZIndex="2"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          CornerRadius="12" BorderThickness="2"
                                          BorderBrush="#E0FFFFFF" Background="#66000000"
                                          IsVisible="{Binding ShowEmptyCheck}"/>
                                  <!-- selected: Google Photos blue + tick -->
                                  <Border Width="24" Height="24" Margin="6" ZIndex="2"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          CornerRadius="12" BorderThickness="2"
                                          BorderBrush="#1A73E8" Background="#1A73E8"
                                          IsVisible="{Binding Selected}">
                                    <Path Width="12" Height="12"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M 1,6 L 4.5,9.5 L 11,2"/>
                                  </Border>
                                </Panel>
                              </Border>
                            </Panel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Margin="14,0,0,0">
        <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto">
          <Image x:Name="PreviewImage" Stretch="Uniform" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="1" x:Name="PreviewName" TextAlignment="Center"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Opacity="0.85" MaxLines="2"
                     Text="Select a photo to preview and caption it"/>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBox x:Name="CaptionBox"
                     PlaceholderText="Caption — stamped and used as the export file name"
                     LostFocus="Caption_LostFocus" IsEnabled="False"
                     ToolTip.Tip="One short line. Exports with a caption are renamed from it."/>
            <Button Grid.Column="1" x:Name="CaptionBtn" Content="Caption" Margin="8,0,0,0"
                    IsEnabled="False" Click="Caption_Click"
                    ToolTip.Tip="Generate a short caption with the local AI model"/>
          </Grid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                      Spacing="8" Margin="0,10,0,0">
            <Button x:Name="SaveOneBtn" Content="Save this photo" IsEnabled="False" Click="SaveOne_Click"
                    ToolTip.Tip="Export only the photo in the preview"/>
            <Button x:Name="CaptionAllBtn" Content="Caption selected" IsEnabled="False"
                    Click="CaptionAll_Click"
                    ToolTip.Tip="Run local AI caption on every selected photo (multi-caption)"/>
            <Button x:Name="DownloadModelBtn" Content="Download AI model"
                    Click="DownloadModel_Click"
                    ToolTip.Tip="One-time download. Captioning then runs offline."/>
          </StackPanel>

          <ProgressBar Grid.Row="4" x:Name="AiProgress" Margin="0,10,0,0" Height="4"
                       Minimum="0" Maximum="100" IsVisible="False"/>
          <TextBlock Grid.Row="5" x:Name="AiStatus" Classes="hint" Margin="0,6,0,0"
                     TextAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
