<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoLog.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="PhotoLog.Avalonia.MainWindow"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        Title="PhotoLog"
        Icon="/Assets/icon.png"
        Background="{DynamicResource BrushWindow}">

  <!-- Wireframe:
       [ folder bar ]
       [ grid preview | live preview + date/time/addr/shadow/caption ]
       [ selected horizontal strip ]
       [ bottom: output + apply ]
  -->
  <DockPanel Margin="12">

    <!-- Top: folder only — no logo / title / long description -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <TextBlock Text="📁" FontSize="15" VerticalAlignment="Center" Margin="2,0,8,0"
                   Foreground="{DynamicResource BrushAccent}"/>
        <TextBox Grid.Column="1" x:Name="FolderBox"
                 BorderThickness="0" Background="Transparent" Padding="0,4"
                 VerticalAlignment="Center"
                 PlaceholderText="/path/to/photos — Enter to load"
                 ToolTip.Tip="Photo folder. Press Enter to load."
                 KeyDown="Folder_KeyDown"/>
        <TextBlock Grid.Column="2" x:Name="Status" Classes="hint" Margin="10,0,10,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="220" Text=""/>
        <Button Grid.Column="3" x:Name="ThemeBtn" Classes="quiet" Content="Light" Padding="10,5"
                Margin="0,0,6,0" Click="Theme_Click" ToolTip.Tip="Toggle light/dark theme"/>
        <Button Grid.Column="4" Classes="quiet" Content="Browse…" Padding="10,5"
                Margin="0,0,6,0" Click="Browse_Click"/>
        <Button Grid.Column="5" Classes="accent" Content="Load" Padding="14,5"
                Click="Browse_Click"/>
      </Grid>
    </Border>

    <!-- Bottom: one tight line -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Classes="hint" Text="Out" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Column="1" x:Name="OutBox" MinHeight="32" Padding="8,4"
                 VerticalAlignment="Center"
                 PlaceholderText="Output folder"
                 LostFocus="OutBox_LostFocus"/>
        <Button Grid.Column="2" Classes="quiet" Content="Browse…" Padding="10,5"
                Margin="8,0,0,0" VerticalAlignment="Center" Click="OutBrowse_Click"/>
        <Button Grid.Column="3" x:Name="ApplyBtn" Classes="accent" Margin="8,0,0,0"
                Padding="14,5" VerticalAlignment="Center"
                Content="✓ Apply" Click="Apply_Click"
                ToolTip.Tip="Write stamped copies of selected photos"/>
      </Grid>
    </Border>
    <!-- Status under bottom is one short line, not a second card -->
    <TextBlock DockPanel.Dock="Bottom" x:Name="Result" Classes="hint" Margin="4,0,4,0"
               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
               Text=""/>

    <!-- Compact filmstrip: ◀ · thumbs · ▶ · count (right) — small height -->
    <Border DockPanel.Dock="Bottom" x:Name="SelectedListHost" IsVisible="False"
            Margin="0,4,0,0" Padding="4,2" Background="Transparent">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button x:Name="PrevSelBtn2" Classes="quiet" Content="◀"
                Padding="8,2" FontSize="14" MinWidth="32" MinHeight="36"
                VerticalAlignment="Center" Margin="0,0,4,0"
                IsEnabled="False" Click="PrevSelected_Click"
                ToolTip.Tip="Previous selected"/>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" AllowAutoHide="True"
                      VerticalAlignment="Center" MaxHeight="40">
          <ItemsControl x:Name="SelectedList" HorizontalAlignment="Left">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="3"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:PhotoItem">
                <Border Cursor="Hand" Width="36" Height="36" CornerRadius="5"
                        ClipToBounds="True" BorderThickness="1"
                        BorderBrush="{DynamicResource BrushBorder}"
                        Background="{DynamicResource BrushThumbBg}"
                        PointerPressed="SelectedListItem_Click"
                        ToolTip.Tip="{Binding Name}">
                  <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Column="2" x:Name="NextSelBtn2" Classes="quiet" Content="▶"
                Padding="8,2" FontSize="14" MinWidth="32" MinHeight="36"
                VerticalAlignment="Center" Margin="4,0,8,0"
                IsEnabled="False" Click="NextSelected_Click"
                ToolTip.Tip="Next selected"/>
        <TextBlock Grid.Column="3" x:Name="SelectedListHeader" Classes="hint"
                   VerticalAlignment="Center" FontWeight="SemiBold"
                   Margin="0,0,2,0" Text="0"/>
      </Grid>
    </Border>

    <!-- Body: library | draggable splitter | preview (not fixed 3:2) -->
    <Grid ColumnDefinitions="*,6,*" RowDefinitions="*">

      <!-- LEFT: library grid -->
      <Border Classes="card" MinWidth="280" Padding="10">
        <DockPanel>
          <StackPanel x:Name="LibToolbar" DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4" IsVisible="False">
            <!-- One line: select + AI -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="quiet" Content="Select all" Padding="10,5" Click="SelectAll_Click"/>
              <Button Classes="quiet" Content="Select none" Padding="10,5" Click="SelectNone_Click"/>
              <Border Width="1" Height="18" Background="{DynamicResource BrushBorder}"
                      VerticalAlignment="Center" Margin="4,0"/>
              <TextBlock Classes="hint" Text="AI" VerticalAlignment="Center"
                         ToolTip.Tip="YOLO26n COCO objects. Detect once, cache labels."/>
              <ComboBox x:Name="AiCategoryBox" Width="120" MinHeight="30" SelectedIndex="0"/>
              <TextBox x:Name="AiCustomBox" Width="96" MinHeight="30"
                       PlaceholderText="or dog…"
                       ToolTip.Tip="COCO class name (dog, chair, car…)"/>
              <Button x:Name="AiSelectBtn" Classes="quiet" Content="AI select"
                      Padding="10,5" Click="AiSelect_Click"/>
              <ProgressBar x:Name="AiProgress" Minimum="0" Maximum="100" Width="100"
                           Height="5" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0"/>
              <TextBlock x:Name="AiStatus" Classes="hint" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="200"/>
            </StackPanel>
          </StackPanel>

          <Grid>
            <Border x:Name="EmptyGrid" Classes="dashEmpty" IsVisible="True" Margin="2">
              <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                <TextBlock Text="No photos loaded" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Browse a folder of photos to start."/>
                <Button Classes="accent" Content="Browse folder…" Padding="18,8"
                        HorizontalAlignment="Center" Click="Browse_Click"/>
              </StackPanel>
            </Border>

            <Grid x:Name="LibScrollHost" IsVisible="False" ColumnDefinitions="*,Auto">
              <!-- Vertical scrollbar Hidden when selection map is on (one track only). -->
              <ScrollViewer x:Name="PhotoScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            ScrollChanged="PhotoScroll_ScrollChanged">
                <ItemsControl x:Name="PhotoGrid">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DayGroup">
                      <StackPanel Margin="0,0,0,8">
                        <Border Cursor="Hand" Background="Transparent"
                                ToolTip.Tip="Select or deselect this day"
                                PointerPressed="DayHeader_Click">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,6,2,4">
                            <Border Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushSelect}" Background="{DynamicResource BrushSelect}"
                                    IsVisible="{Binding ShowPartialDayCheck}">
                              <Path Width="8" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stretch="Fill" Stroke="White" StrokeThickness="2" Data="M 0,1 L 10,1"/>
                            </Border>
                            <Border Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushSelect}" Background="{DynamicResource BrushSelect}"
                                    IsVisible="{Binding ShowAllDayCheck}">
                              <Path Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                    Data="M 1,6 L 4.5,9.5 L 11,2"/>
                            </Border>
                            <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Photos}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PhotoItem">
                              <Border Height="{Binding CellH}" Width="{Binding CellW}" Margin="2"
                                      Background="Transparent" Cursor="Hand"
                                      ToolTip.Tip="{Binding Tip}"
                                      PointerPressed="Cell_Click">
                                <Panel>
                                  <Border CornerRadius="8" Margin="1"
                                          Background="{DynamicResource BrushSelectPlate}"
                                          IsVisible="{Binding Selected}"/>
                                  <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                          Margin="0,3" CornerRadius="2"
                                          Background="{DynamicResource BrushSelect}"
                                          IsVisible="{Binding Selected}" ZIndex="5"/>
                                  <Border Margin="{Binding ThumbMargin}" CornerRadius="6"
                                          ClipToBounds="True" Background="{DynamicResource BrushThumbBg}">
                                    <Panel>
                                      <Image Source="{Binding Thumb}" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      <Border Width="20" Height="20" Margin="4" ZIndex="4"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              CornerRadius="10" BorderThickness="2"
                                              BorderBrush="{DynamicResource BrushSelect}"
                                              Background="{DynamicResource BrushSelect}"
                                              IsVisible="{Binding Selected}">
                                        <Path Width="9" Height="9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                              Data="M 1,6 L 4.5,9.5 L 11,2"/>
                                      </Border>
                                    </Panel>
                                  </Border>
                                </Panel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Selection ticks only (not a second scrollbar). Native bar hides while this is on. -->
              <Border Grid.Column="1" x:Name="SelectOverview" Width="10" Margin="2,0,0,0"
                      IsVisible="False" Cursor="Hand" ClipToBounds="True"
                      Background="Transparent"
                      ToolTip.Tip="Selection marks — click to jump"
                      PointerPressed="SelectOverview_Pressed"
                      SizeChanged="SelectOverview_SizeChanged">
                <Panel>
                  <Border x:Name="SelectViewport" Margin="1,0" HorizontalAlignment="Stretch"
                          Height="16" VerticalAlignment="Top" CornerRadius="2"
                          Background="{DynamicResource BrushMuted}" Opacity="0.25"
                          IsHitTestVisible="False"/>
                  <Canvas x:Name="SelectMarks" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Panel>
              </Border>
            </Grid>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Drag to resize library vs preview -->
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" ResizeDirection="Columns"
                    Background="{DynamicResource BrushBorder}"
                    ToolTip.Tip="Drag to resize library / preview"/>

      <!-- RIGHT: live preview on top, stamp controls below -->
      <Border Grid.Column="2" Classes="card" MinWidth="260" Padding="10">
        <Grid RowDefinitions="*,Auto">

          <!-- Live preview only — clean, no selected list stacked on top -->
          <Grid MinHeight="160">
            <Border x:Name="PreviewEmpty" Classes="dashEmpty" IsVisible="True">
              <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240">
                <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Opacity="0.7"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Click a photo to preview the stamp."/>
              </StackPanel>
            </Border>
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
          </Grid>

          <!-- Date|Time share one row (equal columns). Address is multi-line again. -->
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
            <TextBlock x:Name="PreviewName" Classes="hint" TextAlignment="Left"
                       TextTrimming="CharacterEllipsis" MaxLines="1" IsVisible="False" Text=""/>

            <Grid ColumnDefinitions="*,8,*">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="Date" Margin="0,0,0,2"/>
                <Grid ColumnDefinitions="*,Auto">
                  <CalendarDatePicker x:Name="DatePart" MinHeight="32" MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      SelectedDateChanged="DateChanged"/>
                  <Button Grid.Column="1" Classes="quiet" Content="×" Padding="8,4" Margin="4,0,0,0"
                          Click="ClearDate_Click" ToolTip.Tip="Clear date override"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Classes="label" Text="Time" Margin="0,0,0,2"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TimePicker x:Name="TimePart" MinHeight="32" MinWidth="0"
                              HorizontalAlignment="Stretch"
                              ClockIdentifier="12HourClock" UseSeconds="True"
                              SelectedTimeChanged="TimeChanged"/>
                  <Button Grid.Column="1" Classes="quiet" Content="×" Padding="8,4" Margin="4,0,0,0"
                          Click="ClearTime_Click" ToolTip.Tip="Clear time override"/>
                </Grid>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Address" Margin="0,0,0,2"/>
              <TextBox x:Name="AddrBox" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="64" MaxHeight="110" Padding="8,6"
                       LostFocus="Addr_LostFocus"
                       PlaceholderText="Optional address lines (selected photos only)"/>
            </StackPanel>

            <StackPanel Spacing="2"
                        ToolTip.Tip="+X right, −Y up. Saved between sessions.">
              <TextBlock Classes="label" Text="Drop shadow" Margin="0,0,0,2"/>
              <!-- Full-width grid so combo + X/Y spinboxes actually fill the pane -->
              <Grid ColumnDefinitions="*,Auto,1.1*,Auto,1.1*,Auto" MinHeight="36">
                <ComboBox x:Name="DropBox" MinHeight="36" HorizontalAlignment="Stretch"
                          SelectedIndex="1" SelectionChanged="DropChanged">
                  <ComboBoxItem Content="Off" Tag="Off"/>
                  <ComboBoxItem Content="Light" Tag="Light"/>
                  <ComboBoxItem Content="Heavy" Tag="Heavy"/>
                </ComboBox>
                <TextBlock Grid.Column="1" Text="X" Classes="hint" VerticalAlignment="Center"
                           Margin="10,0,6,0"/>
                <NumericUpDown Grid.Column="2" x:Name="ShadowXBox" Value="1"
                               Minimum="-20" Maximum="20" Increment="1" FormatString="0"
                               MinHeight="36" MinWidth="72" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Padding="8,4"
                               ShowButtonSpinner="True" AllowSpin="True"
                               ButtonSpinnerLocation="Right"
                               ValueChanged="OffsetChanged"/>
                <TextBlock Grid.Column="3" Text="Y" Classes="hint" VerticalAlignment="Center"
                           Margin="10,0,6,0"/>
                <NumericUpDown Grid.Column="4" x:Name="ShadowYBox" Value="-1"
                               Minimum="-20" Maximum="20" Increment="1" FormatString="0"
                               MinHeight="36" MinWidth="72" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Padding="8,4"
                               ShowButtonSpinner="True" AllowSpin="True"
                               ButtonSpinnerLocation="Right"
                               ValueChanged="OffsetChanged"/>
                <Button Grid.Column="5" Classes="quiet" Content="↻" Padding="12,6"
                        Margin="8,0,0,0" MinHeight="36" VerticalAlignment="Stretch"
                        Click="Refresh_Click" ToolTip.Tip="Refresh thumbs"/>
              </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="CaptionBox" MinHeight="32" Padding="8,4"
                       PlaceholderText="Caption → export name"
                       LostFocus="Caption_LostFocus" IsEnabled="False"/>
              <Button Grid.Column="1" x:Name="CaptionBtn" Classes="quiet" Content="Caption"
                      Margin="6,0,0,0" Padding="10,5" IsEnabled="False" Click="Caption_Click"/>
            </Grid>

            <Grid ColumnDefinitions="*,*">
              <Button x:Name="SaveOneBtn" Classes="quiet" Content="Save one"
                      IsEnabled="False" Click="SaveOne_Click" Margin="0,0,3,0"
                      HorizontalAlignment="Stretch" Padding="8,5"/>
              <Button Grid.Column="1" x:Name="CaptionAllBtn" Classes="quiet" Content="Caption sel"
                      IsEnabled="False" Click="CaptionAll_Click" Margin="3,0,0,0"
                      HorizontalAlignment="Stretch" Padding="8,5"/>
            </Grid>

            <Button x:Name="DownloadModelBtn" Classes="quiet" Padding="8,5"
                    Content="Download caption model" HorizontalAlignment="Stretch"
                    Click="DownloadModel_Click"
                    ToolTip.Tip="Gemma 4 E2B for captions. AI select uses YOLO (~10 MB)."/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
