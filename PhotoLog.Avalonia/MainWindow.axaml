<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoLog.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="PhotoLog.Avalonia.MainWindow"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        Title="PhotoLog"
        Icon="/Assets/icon.png"
        Background="{DynamicResource BrushWindow}">

  <!-- Wireframe:
       [ folder bar ]
       [ grid preview | live preview + date/time/addr/shadow/caption ]
       [ selected horizontal strip ]
       [ bottom: output + apply ]
  -->

  <Window.Styles>
    <!-- Grid cells fade in; .sel drives the selection chrome below -->
    <Style Selector="Border.cell">
      <Style.Animations>
        <Animation Duration="0:0:0.25" FillMode="Backward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Thumb: hover lift + shadow, animated select inset -->
    <Style Selector="Border.thumbHost">
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
          <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut"/>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- Shadow stays imperceptible: the reference has none. Hover reads via the scale. -->
    <Style Selector="Border.cell:pointerover Border.thumbHost">
      <Setter Property="RenderTransform" Value="scale(1.02)"/>
      <Setter Property="BoxShadow" Value="0 2 8 0 #14000000"/>
    </Style>

    <!-- Selection plate + edge bar fade; check chip pops with overshoot -->
    <Style Selector="Border.plate, Border.bar">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16"/></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.cell.sel Border.plate, Border.cell.sel Border.bar">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="RenderTransform" Value="scale(0.5)"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.cell.sel Border.chip">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>

    <!-- Thumbs fade in as they decode -->
    <Style Selector="Image.thumb">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3"/></Transitions>
      </Setter>
    </Style>
    <Style Selector="Image.thumb.loaded"><Setter Property="Opacity" Value="1"/></Style>

    <!-- Day sections fade in (keyframes can't animate RenderTransform — transitions only) -->
    <Style Selector="StackPanel.dayGroup">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Backward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Filmstrip: hover scale, active ring fade -->
    <Style Selector="Border.filmItem">
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.filmItem:pointerover"><Setter Property="RenderTransform" Value="scale(1.08)"/></Style>
    <Style Selector="Border.filmItem Border.ring">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.filmItem.active Border.ring"><Setter Property="Opacity" Value="1"/></Style>

    <!-- Preview fade-in; class retoggled in code when the source changes -->
    <Style Selector="Image.fadein">
      <Style.Animations>
        <Animation Duration="0:0:0.22" FillMode="Backward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">

    <!-- Top: folder path bar — dashed hairline, mono path, pills on the right -->
    <Panel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Rectangle Classes="dash"/>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="16,10">
        <!-- Hairline folder glyph: the emoji was the only saturated thing on screen -->
        <Path Width="15" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,12,0"
              Stroke="{DynamicResource BrushMuted}" StrokeThickness="1.2"
              Data="M1,3 L1,11 L15,11 L15,4.5 L7.5,4.5 L6,3 Z"/>
        <TextBox Grid.Column="1" x:Name="FolderBox"
                 BorderThickness="0" Background="Transparent" Padding="0"
                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                 MinHeight="28"
                 PlaceholderText="/path/to/photos — Enter to load"
                 ToolTip.Tip="Photo folder. Press Enter to load."
                 KeyDown="Folder_KeyDown"/>
        <TextBlock Grid.Column="2" x:Name="Status" Classes="hint" Margin="16,0,16,0"
                   VerticalAlignment="Center" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="220" Text=""/>
        <Button Grid.Column="3" x:Name="ThemeBtn" Classes="quiet" Content="Light"
                Margin="0,0,10,0" VerticalAlignment="Center"
                Click="Theme_Click" ToolTip.Tip="Toggle light/dark theme"/>
        <Button Grid.Column="4" Classes="quiet" Content="Browse…"
                Margin="0,0,10,0" VerticalAlignment="Center" Click="Browse_Click"/>
        <Button Grid.Column="5" Classes="primary" Content="Load"
                VerticalAlignment="Center" Click="Browse_Click"/>
      </Grid>
    </Panel>

    <!-- Bottom: Out label | path | Browse | Apply — one baseline -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="36">
        <TextBlock Classes="hint" Text="Out" VerticalAlignment="Center"
                   TextAlignment="Left" Margin="0,0,12,0"/>
        <TextBox Grid.Column="1" x:Name="OutBox"
                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                 PlaceholderText="Output folder"
                 LostFocus="OutBox_LostFocus"/>
        <Button Grid.Column="2" Classes="quiet" Content="Browse…"
                Margin="12,0,0,0" VerticalAlignment="Center" Click="OutBrowse_Click"/>
        <Button Grid.Column="3" x:Name="ApplyBtn" Classes="primary" Margin="10,0,0,0"
                VerticalAlignment="Center"
                Content="✓ Apply" Click="Apply_Click"
                ToolTip.Tip="Write stamped copies of selected photos"/>
      </Grid>
    </Border>
    <!-- Status under bottom is one short line, not a second card -->
    <TextBlock DockPanel.Dock="Bottom" x:Name="Result" Classes="hint" Margin="8,0,8,0"
               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
               Text=""/>

    <!-- Body: library | draggable splitter | preview (not fixed 3:2) -->
    <Grid ColumnDefinitions="*,12,*" RowDefinitions="*">

      <!-- LEFT: library grid + filmstrip aligned under the photos (same card) -->
      <Border Classes="card" MinWidth="280">
        <DockPanel>
          <!-- Selected strip under library images — same left edge as thumbs -->
          <Border DockPanel.Dock="Bottom" x:Name="SelectedListHost" IsVisible="False"
                  Margin="0,12,0,0" Padding="0,2,0,0" Background="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Button x:Name="PrevSelBtn2" Classes="quiet icon" Content="◀"
                      MinWidth="36" MinHeight="36"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      IsEnabled="False" Click="PrevSelected_Click"
                      ToolTip.Tip="Previous selected"/>
              <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled" AllowAutoHide="True"
                            VerticalAlignment="Center" MaxHeight="40">
                <ItemsControl x:Name="SelectedList" HorizontalAlignment="Left">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="3"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PhotoItem">
                      <Border Classes="filmItem" Classes.active="{Binding IsActivePreview}"
                              Cursor="Hand" Width="36" Height="36" CornerRadius="8"
                              ClipToBounds="True" BorderThickness="1"
                              BorderBrush="{DynamicResource BrushBorder}"
                              Background="{DynamicResource BrushThumbBg}"
                              PointerPressed="SelectedListItem_Click"
                              ToolTip.Tip="{Binding Name}">
                        <Panel>
                          <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                          <Border Classes="ring" BorderBrush="{DynamicResource BrushSelect}" BorderThickness="2.5"
                                  CornerRadius="8" IsHitTestVisible="False"/>
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button Grid.Column="2" x:Name="NextSelBtn2" Classes="quiet icon" Content="▶"
                      MinWidth="36" MinHeight="36"
                      VerticalAlignment="Center" Margin="10,0,12,0"
                      IsEnabled="False" Click="NextSelected_Click"
                      ToolTip.Tip="Next selected"/>
              <Border Grid.Column="3" Classes="tag" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedListHeader" Text="0"/>
              </Border>
            </Grid>
          </Border>

          <StackPanel x:Name="LibToolbar" DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12" IsVisible="False">
            <!-- One line: select + AI -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="quiet" Content="Select all" VerticalAlignment="Center"
                      Click="SelectAll_Click"/>
              <Button Classes="quiet" Content="Select none" VerticalAlignment="Center"
                      Click="SelectNone_Click"/>
              <Border Width="1" Height="18" Background="{DynamicResource BrushBorder}"
                      VerticalAlignment="Center" Margin="2,0"/>
              <TextBlock Classes="hint" Text="AI" VerticalAlignment="Center"
                         ToolTip.Tip="YOLO26n COCO objects. Detect once, cache labels."/>
              <ComboBox x:Name="AiCategoryBox" Width="120" VerticalAlignment="Center"
                        SelectedIndex="0"/>
              <TextBox x:Name="AiCustomBox" Width="92" VerticalAlignment="Center"
                       PlaceholderText="or dog…"
                       ToolTip.Tip="COCO class name (dog, chair, car…)"/>
              <Button x:Name="AiSelectBtn" Classes="quiet" Content="AI select"
                      VerticalAlignment="Center" Click="AiSelect_Click"/>
              <ProgressBar x:Name="AiProgress" Minimum="0" Maximum="100" Width="100"
                           Height="5" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0"/>
              <TextBlock x:Name="AiStatus" Classes="hint" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="200"/>
            </StackPanel>
          </StackPanel>

          <Grid>
            <Panel x:Name="EmptyGrid" IsVisible="True">
              <Rectangle Classes="dash"/>
              <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                <TextBlock Text="No photos loaded" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Browse a folder of photos to start."/>
                <Button Classes="primary" Content="Browse folder…"
                        HorizontalAlignment="Center" Click="Browse_Click"/>
              </StackPanel>
            </Panel>

            <Grid x:Name="LibScrollHost" IsVisible="False" ColumnDefinitions="*,Auto">
              <!-- Vertical scrollbar Hidden when selection map is on (one track only). -->
              <ScrollViewer x:Name="PhotoScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            ScrollChanged="PhotoScroll_ScrollChanged">
                <ItemsControl x:Name="PhotoGrid">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DayGroup">
                      <StackPanel Classes="dayGroup" Margin="0,0,0,8">
                        <Border Cursor="Hand" Background="Transparent"
                                ToolTip.Tip="Select or deselect this day"
                                PointerPressed="DayHeader_Click">
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,2,6">
                            <Border Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushSelect}" Background="{DynamicResource BrushSelect}"
                                    IsVisible="{Binding ShowPartialDayCheck}">
                              <Path Width="8" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stretch="Fill" Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="2" Data="M 0,1 L 10,1"/>
                            </Border>
                            <Border Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushSelect}" Background="{DynamicResource BrushSelect}"
                                    IsVisible="{Binding ShowAllDayCheck}">
                              <Path Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Stretch="Uniform" Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="2"
                                    Data="M 1,6 L 4.5,9.5 L 11,2"/>
                            </Border>
                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontMono}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Photos}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <local:JustifiedPanel RowHeight="160" Spacing="6"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PhotoItem">
                              <Border Classes="cell" Classes.sel="{Binding Selected}"
                                      local:JustifiedPanel.Aspect="{Binding Aspect}"
                                      Background="Transparent" Cursor="Hand"
                                      ToolTip.Tip="{Binding Tip}"
                                      PointerPressed="Cell_Click">
                                <Panel>
                                  <Border Classes="plate" CornerRadius="12" Margin="1"
                                          Background="{DynamicResource BrushSelectPlate}"/>
                                  <Border Classes="bar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                          Margin="0,4" CornerRadius="2"
                                          Background="{DynamicResource BrushSelect}" ZIndex="5"/>
                                  <Border Classes="thumbHost" Margin="{Binding ThumbMargin}" CornerRadius="8"
                                          ClipToBounds="True" Background="{DynamicResource BrushThumbBg}">
                                    <Panel>
                                      <Image Classes="thumb"
                                             Classes.loaded="{Binding Thumb, Converter={x:Static ObjectConverters.IsNotNull}}"
                                             Source="{Binding Thumb}" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      <!-- Hairline inset ring so white/black photos read against any card -->
                                      <Border CornerRadius="8" BorderThickness="1" ZIndex="3"
                                              BorderBrush="{DynamicResource BrushThumbRing}"
                                              IsHitTestVisible="False"/>
                                      <Border Classes="chip" Width="20" Height="20" Margin="4" ZIndex="4"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              CornerRadius="10" BorderThickness="2"
                                              BorderBrush="{DynamicResource BrushSelect}"
                                              Background="{DynamicResource BrushSelect}">
                                        <Path Width="9" Height="9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform" Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="2"
                                              Data="M 1,6 L 4.5,9.5 L 11,2"/>
                                      </Border>
                                    </Panel>
                                  </Border>
                                </Panel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Selection ticks only (not a second scrollbar). Native bar hides while this is on. -->
              <Border Grid.Column="1" x:Name="SelectOverview" Width="10" Margin="2,0,0,0"
                      IsVisible="False" Cursor="Hand" ClipToBounds="True"
                      Background="Transparent"
                      ToolTip.Tip="Selection marks — click to jump"
                      PointerPressed="SelectOverview_Pressed"
                      SizeChanged="SelectOverview_SizeChanged">
                <Panel>
                  <Border x:Name="SelectViewport" Margin="1,0" HorizontalAlignment="Stretch"
                          Height="16" VerticalAlignment="Top" CornerRadius="2"
                          Background="{DynamicResource BrushMuted}" Opacity="0.25"
                          IsHitTestVisible="False"/>
                  <Canvas x:Name="SelectMarks" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Panel>
              </Border>
            </Grid>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Drag to resize library vs preview -->
      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" ResizeDirection="Columns"
                    Background="{DynamicResource BrushWindow}"
                    ToolTip.Tip="Drag to resize library / preview"/>

      <!-- RIGHT: live preview on top, stamp controls below -->
      <Border Grid.Column="2" Classes="card" MinWidth="260">
        <Grid RowDefinitions="*,Auto">

          <!-- Live preview only — clean, no selected list stacked on top -->
          <Grid MinHeight="160">
            <Panel x:Name="PreviewEmpty" IsVisible="True">
              <Rectangle Classes="dash"/>
              <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="220" Text="Click a photo to preview the stamp."/>
            </Panel>
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
          </Grid>

          <!-- Controls only — no Date/Time/Address/Shadow labels (placeholders + tips). -->
          <StackPanel Grid.Row="1" Spacing="10" Margin="0,14,0,0">
            <TextBlock x:Name="PreviewName" Classes="value" TextAlignment="Left"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1" IsVisible="False" Text=""/>

            <!-- Date | Time: same height, clear × buttons center-aligned with fields -->
            <Grid ColumnDefinitions="*,12,*" MinHeight="36"
                  VerticalAlignment="Center">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                    ToolTip.Tip="Date override (empty = keep each photo’s day)">
                <CalendarDatePicker x:Name="DatePart" MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    SelectedDateChanged="DateChanged"/>
                <Button Grid.Column="1" Classes="quiet icon" Content="×" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Click="ClearDate_Click" ToolTip.Tip="Clear date override"/>
              </Grid>
              <Grid Grid.Column="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                    ToolTip.Tip="Time override (empty = keep each photo’s clock)">
                <TimePicker x:Name="TimePart" MinWidth="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ClockIdentifier="12HourClock" UseSeconds="True"
                            SelectedTimeChanged="TimeChanged"/>
                <Button Grid.Column="1" Classes="quiet icon" Content="×" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Click="ClearTime_Click" ToolTip.Tip="Clear time override"/>
              </Grid>
            </Grid>

            <TextBox x:Name="AddrBox" Classes="multiline" AcceptsReturn="True"
                     TextWrapping="Wrap" MaxHeight="100"
                     LostFocus="Addr_LostFocus"
                     PlaceholderText="Address (selected only)"
                     ToolTip.Tip="Optional address lines applied to selected photos"/>

            <Grid ColumnDefinitions="*,Auto,1.1*,Auto,1.1*,Auto" MinHeight="36"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Drop shadow: +X right, −Y up">
              <ComboBox x:Name="DropBox" HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        SelectedIndex="1" SelectionChanged="DropChanged">
                <ComboBoxItem Content="Off" Tag="Off"/>
                <ComboBoxItem Content="Light" Tag="Light"/>
                <ComboBoxItem Content="Heavy" Tag="Heavy"/>
              </ComboBox>
              <TextBlock Grid.Column="1" Text="X" Classes="hint"
                         VerticalAlignment="Center" TextAlignment="Center"
                         Margin="12,0,8,0" Width="12"/>
              <NumericUpDown Grid.Column="2" x:Name="ShadowXBox" Value="1"
                             Minimum="-20" Maximum="20" Increment="1" FormatString="0"
                             MinWidth="72" HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             ShowButtonSpinner="True" AllowSpin="True"
                             ButtonSpinnerLocation="Right"
                             ValueChanged="OffsetChanged"/>
              <TextBlock Grid.Column="3" Text="Y" Classes="hint"
                         VerticalAlignment="Center" TextAlignment="Center"
                         Margin="12,0,8,0" Width="12"/>
              <NumericUpDown Grid.Column="4" x:Name="ShadowYBox" Value="-1"
                             Minimum="-20" Maximum="20" Increment="1" FormatString="0"
                             MinWidth="72" HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             ShowButtonSpinner="True" AllowSpin="True"
                             ButtonSpinnerLocation="Right"
                             ValueChanged="OffsetChanged"/>
              <Button Grid.Column="5" Classes="quiet icon" Content="↻"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      Click="Refresh_Click" ToolTip.Tip="Refresh thumbs"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" MinHeight="36" VerticalAlignment="Center">
              <TextBox x:Name="CaptionBox"
                       VerticalAlignment="Center" VerticalContentAlignment="Center"
                       PlaceholderText="Caption → export name"
                       LostFocus="Caption_LostFocus" IsEnabled="False"/>
              <Button Grid.Column="1" x:Name="CaptionBtn" Classes="quiet" Content="Caption"
                      Margin="10,0,0,0" VerticalAlignment="Center"
                      IsEnabled="False" Click="Caption_Click"/>
            </Grid>

            <!-- Segmented pair: even gap, equal height, centered labels -->
            <Grid ColumnDefinitions="*,*" MinHeight="36">
              <Button x:Name="SaveOneBtn" Classes="quiet" Content="Save one"
                      IsEnabled="False" Click="SaveOne_Click" Margin="0,0,5,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              <Button Grid.Column="1" x:Name="CaptionAllBtn" Classes="quiet"
                      Content="Caption sel"
                      IsEnabled="False" Click="CaptionAll_Click" Margin="5,0,0,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>

            <Button x:Name="DownloadModelBtn" Classes="quiet"
                    Content="Download caption model" HorizontalAlignment="Stretch"
                    Click="DownloadModel_Click"
                    ToolTip.Tip="Gemma 4 E2B for captions. AI select uses YOLO (~10 MB)."/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
