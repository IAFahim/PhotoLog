<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotoLog.Avalonia.App"
             RequestedThemeVariant="Dark">
  <!-- Light purple mockup + dark counterpart. Brushes are theme-dictionary so toggle is live. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Default/Light: neutral surfaces + Google-blue accent -->
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="BrushWindow" Color="#F6F7F9"/>
          <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BrushField" Color="#F1F3F6"/>
          <SolidColorBrush x:Key="BrushElevated" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BrushBorder" Color="#E2E5EA"/>
          <SolidColorBrush x:Key="BrushBorderMuted" Color="#C6CBD2"/>
          <SolidColorBrush x:Key="BrushText" Color="#1F2328"/>
          <SolidColorBrush x:Key="BrushMuted" Color="#5C6470"/>
          <SolidColorBrush x:Key="BrushDim" Color="#98A0AA"/>
          <SolidColorBrush x:Key="BrushAccent" Color="#1A73E8"/>
          <SolidColorBrush x:Key="BrushAccentHover" Color="#1765CC"/>
          <SolidColorBrush x:Key="BrushAccentSoft" Color="#E8F0FE"/>
          <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BrushSelect" Color="#1A73E8"/>
          <SolidColorBrush x:Key="BrushSelectPlate" Color="#E8F0FE"/>
          <SolidColorBrush x:Key="BrushThumbBg" Color="#EAEDF1"/>
          <SolidColorBrush x:Key="BrushThumbRing" Color="#16000000"/>
          <SolidColorBrush x:Key="BrushDash" Color="#A8C7FA"/>
          <SolidColorBrush x:Key="BrushDashFill" Color="#0A1A73E8"/>
          <SolidColorBrush x:Key="BrushCardShadow" Color="#0A000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BrushWindow" Color="#F6F7F9"/>
          <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BrushField" Color="#F1F3F6"/>
          <SolidColorBrush x:Key="BrushElevated" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BrushBorder" Color="#E2E5EA"/>
          <SolidColorBrush x:Key="BrushBorderMuted" Color="#C6CBD2"/>
          <SolidColorBrush x:Key="BrushText" Color="#1F2328"/>
          <SolidColorBrush x:Key="BrushMuted" Color="#5C6470"/>
          <SolidColorBrush x:Key="BrushDim" Color="#98A0AA"/>
          <SolidColorBrush x:Key="BrushAccent" Color="#1A73E8"/>
          <SolidColorBrush x:Key="BrushAccentHover" Color="#1765CC"/>
          <SolidColorBrush x:Key="BrushAccentSoft" Color="#E8F0FE"/>
          <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BrushSelect" Color="#1A73E8"/>
          <SolidColorBrush x:Key="BrushSelectPlate" Color="#E8F0FE"/>
          <SolidColorBrush x:Key="BrushThumbBg" Color="#EAEDF1"/>
          <SolidColorBrush x:Key="BrushThumbRing" Color="#16000000"/>
          <SolidColorBrush x:Key="BrushDash" Color="#A8C7FA"/>
          <SolidColorBrush x:Key="BrushDashFill" Color="#0A1A73E8"/>
          <SolidColorBrush x:Key="BrushCardShadow" Color="#0A000000"/>
        </ResourceDictionary>
        <!-- Dark: deep neutral surfaces, light-blue accent with dark glyphs on it -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BrushWindow" Color="#101114"/>
          <SolidColorBrush x:Key="BrushCard" Color="#1A1C20"/>
          <SolidColorBrush x:Key="BrushField" Color="#141619"/>
          <SolidColorBrush x:Key="BrushElevated" Color="#24272C"/>
          <SolidColorBrush x:Key="BrushBorder" Color="#2B2E34"/>
          <SolidColorBrush x:Key="BrushBorderMuted" Color="#3F434B"/>
          <SolidColorBrush x:Key="BrushText" Color="#E8EAED"/>
          <SolidColorBrush x:Key="BrushMuted" Color="#9AA0A6"/>
          <SolidColorBrush x:Key="BrushDim" Color="#6E747C"/>
          <SolidColorBrush x:Key="BrushAccent" Color="#8AB4F8"/>
          <SolidColorBrush x:Key="BrushAccentHover" Color="#AECBFA"/>
          <SolidColorBrush x:Key="BrushAccentSoft" Color="#20304A"/>
          <SolidColorBrush x:Key="BrushOnAccent" Color="#17202B"/>
          <SolidColorBrush x:Key="BrushSelect" Color="#8AB4F8"/>
          <SolidColorBrush x:Key="BrushSelectPlate" Color="#223349"/>
          <SolidColorBrush x:Key="BrushThumbBg" Color="#23262C"/>
          <SolidColorBrush x:Key="BrushThumbRing" Color="#26FFFFFF"/>
          <SolidColorBrush x:Key="BrushDash" Color="#4E6485"/>
          <SolidColorBrush x:Key="BrushDashFill" Color="#148AB4F8"/>
          <SolidColorBrush x:Key="BrushCardShadow" Color="#40000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BrushWindow}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="{DynamicResource BrushElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,9"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="{DynamicResource BrushElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource BrushField}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource BrushField}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource BrushField}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="MinWidth" Value="128"/>
      <!-- Leave room for spinner + signed digits; tight padding + fixed Height was clipping. -->
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <!-- Inner text box of NumericUpDown must not clip “-20”. -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style Selector="CalendarDatePicker">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource BrushField}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="TimePicker">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource BrushField}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.dashEmpty">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushDash}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Background" Value="{DynamicResource BrushDashFill}"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
      <Setter Property="Height" Value="4"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
  </Application.Styles>
</Application>
