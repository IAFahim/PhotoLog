<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotoLog.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the OS light/dark setting. -->

    <Application.Styles>
        <FluentTheme />

        <!-- Fluent/WinUI polish. Custom colours are neutral greys with alpha so a single
             value reads correctly in BOTH light and dark - no per-variant resources needed. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- card surface: the WinUI "layer" look -->
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#0C808080"/>
            <Setter Property="BorderBrush" Value="#24808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Styles>
</Application>
